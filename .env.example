# Public Supabase connection values (safe to expose in a Vite client application).
VITE_SUPABASE_URL=https://nwbgydvzilngvtpkmymw.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Local-only emergency login. Do not enable this in a deployed build: VITE_ values
# are embedded in the browser bundle. Create the administrator in Supabase Auth for production.
VITE_ENABLE_LOCAL_LOGIN=false
VITE_LOCAL_ADMIN_EMAIL=admin@example.com
VITE_LOCAL_ADMIN_PASSWORD=change-this-local-password
